# Supabase Configuration
# Local development must use the hosted persistent `development` branch, never
# the production branch. See docs/SUPABASE_ENVIRONMENTS.md.
SUPABASE_ENVIRONMENT=development
SUPABASE_PRODUCTION_PROJECT_REF=your-production-project-ref
SUPABASE_URL=https://your-development-branch-ref.supabase.co
SUPABASE_ANON_KEY=your-development-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-development-service-role-key

# Client-side Supabase (exposed to browser)
VITE_SUPABASE_URL=https://your-development-branch-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-development-anon-key

# Application URL
APP_URL=http://localhost:3000

# Resend API Key for sending emails
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM="Disciplers of Nations Academy (DINA) <info@christ-dina.org>"

# Better Stack Errors (Sentry-compatible SDK transport)
# Create the application at https://errors.betterstack.com/ and copy its DSN.
VITE_BETTER_STACK_DSN=
# BETTER_STACK_DSN is server-only. Set it as a Cloudflare Worker secret.
BETTER_STACK_DSN=
# VITE_SENTRY_DSN is retained only as a temporary rollback fallback.
VITE_SENTRY_DSN=
# SENTRY_AUTH_TOKEN is used by build/source-map upload tooling.
# SENTRY_AXI_AUTH_TOKEN is used by scripts/sentry-axi.mjs for agent triage calls
# (scopes: org:read event:read event:write). SENTRY_AUTH_TOKEN stays reserved for
# source-map uploads. DINA defaults for axi / fix-sentry skill:
VITE_SENTRY_ENVIRONMENT=local
VITE_SENTRY_RELEASE=local
SENTRY_AUTH_TOKEN=your-sentry-build-upload-token
SENTRY_AXI_AUTH_TOKEN=your-sentry-agent-triage-token
SENTRY_ORG=your-better-stack-team-id
SENTRY_PROJECT=your-better-stack-application-id
# Optional Better Stack-compatible Sentry build endpoint and release identity.
# Keep SENTRY_AUTH_TOKEN server-side; never use a VITE_ prefix for it.
SENTRY_URL=https://your-better-stack-source-endpoint
SENTRY_RELEASE=local

# PostHog product analytics (optional until a project is created)
# Create a project at https://app.posthog.com and copy its public project key.
# The browser sends no events until VITE_POSTHOG_KEY is configured.
VITE_POSTHOG_KEY=your-posthog-project-key
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Admin observability links (public URLs only; never put tokens here)
VITE_BETTER_STACK_DASHBOARD_URL=https://telemetry.betterstack.com/team/your-team/dashboards/your-dashboard
VITE_CLOUDFLARE_DASHBOARD_URL=https://dash.cloudflare.com/your-account/workers/services/view/christ-dina/production/observability
VITE_SUPABASE_DASHBOARD_URL=https://supabase.com/dashboard/project/your-project-ref/database
VITE_NOTION_OPERATIONS_URL=https://www.notion.so/your-workspace/operations-and-runbooks

# WhatsApp Cloud API (Meta) — template messaging from the academy's official number
# Get these from Meta Business Suite > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=your-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_VERSION=v21.0

# Database URL for Drizzle ORM
# Use Supabase's connection pooler (port 6543) for better performance
# Get this from Supabase Dashboard > Project Settings > Database > Connection String > Connection Pooler
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Note: server-side app authorization is primary; Supabase RLS policies provide
# defense in depth where configured.
DATABASE_URL=postgresql://postgres.your-development-branch-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Synthetic account created only in the hosted development branch by
# `bun run db:seed:development`. Use an SMTP-approved test address.
DEVELOPMENT_SEED_EMAIL=your-approved-test-email@example.com
DEVELOPMENT_SEED_PASSWORD=replace-with-a-secret-password
